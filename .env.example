# ============================================================
# PLANTILLA DE CONFIGURACIÓN (.env.local)
# Duplicá este archivo como .env.local y completá los valores
# ============================================================

# 1. Información General del Negocio
VITE_NOMBRE_LOCAL="Nombre del Local"
VITE_DESCRIPCION_LOCAL="Catálogo digital y pedidos online"
VITE_ESLOGAN="Los mejores productos a tu alcance"
VITE_DIRECCION="Av. Principal 123"
VITE_HORARIO="Lun a Sáb · 10:00 - 20:00"
VITE_INSTAGRAM="https://instagram.com/tu_cuenta"

# 2. Número de WhatsApp para recibir pedidos
# (Importante: Con código de país, sin signos '+' ni espacios ni guiones. Ej: Argentina 54911...)
VITE_WHATSAPP_NUMERO="5491112345678"

# 3. Catálogo en la Nube (Google Sheets)
# Pasos: En tu Google Sheets > Archivo > Compartir > Publicar en la web > formato CSV > Pegar URL aquí
# Si se deja vacío, la aplicación mostrará 1 producto de muestra
VITE_SHEETS_CSV_URL=""

# 4. Logos e Íconos
# Podés colocar tu logo en public/imagenes/logo/logo.svg (o logo.png) o ingresar una URL pública de imagen
VITE_LOGO_URL="/imagenes/logo/logo.svg"
VITE_FAVICON_URL="/imagenes/logo/logo.svg"

# 5. Foto de Fondo del Local (Opcional)
# Podés colocar una foto en public/imagenes/fondo.jpg o colocar una URL externa
# Se aplicará automáticamente en blanco y negro para mantener la estética limpia
VITE_FONDO_URL=""


